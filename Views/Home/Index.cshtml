@model ProgrammeTracker.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Summary Stats -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-folder2-open text-primary fs-4"></i>
                </div>
                <div>
                    <div class="display-6 fw-bold">@Model.TotalProgrammes</div>
                    <div class="text-muted small">Total Programmes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                    <i class="bi bi-play-circle text-success fs-4"></i>
                </div>
                <div>
                    <div class="display-6 fw-bold text-success">@Model.ActiveProgrammes</div>
                    <div class="text-muted small">Active</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-danger bg-opacity-10 p-3">
                    <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                </div>
                <div>
                    <div class="display-6 fw-bold text-danger">@Model.OverdueDeliverables</div>
                    <div class="text-muted small">Overdue Deliverables</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                    <i class="bi bi-clock-history text-warning fs-4"></i>
                </div>
                <div>
                    <div class="display-6 fw-bold text-warning">@Model.DueSoonDeliverables</div>
                    <div class="text-muted small">Due Soon</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search client or programme…" />
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var s in new[] { "Active", "Not Active", "Completed" })
                    {
                        <option value="@s" selected="@(Model.FilterStatus == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    @foreach (var t in new[] { "Campus", "Online", "Inhouse" })
                    {
                        <option value="@t" selected="@(Model.FilterType == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
            @if (User.IsInRole("Admin") || User.IsInRole("Account Manager") || User.IsInRole("Project Coordinator"))
            {
                <div class="col-auto ms-auto">
                    <a asp-controller="Programmes" asp-action="Phase1" class="btn btn-sm btn-success">
                        <i class="bi bi-plus-lg"></i> New Programme
                    </a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Tracker Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Client</th>
                        <th>Programme</th>
                        <th>Type</th>
                        <th>Learners</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Funding</th>
                        <th>Status</th>
                        <th>Coordinator</th>
                        <th>Facilitator</th>
                        <th>Phases</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Programmes.Any())
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted py-4">No programmes found.</td>
                        </tr>
                    }
                    @foreach (var p in Model.Programmes)
                    {
                        bool hasOverdue = p.Deliverables.Any(d => d.IsOverdue);
                        <tr class="@(hasOverdue ? "table-danger" : "")">
                            <td>
                                <strong>@p.ClientName</strong>
                                @if (p.IsLegacyImport)
                                {
                                    <span class="badge legacy-badge ms-1">Legacy</span>
                                }
                            </td>
                            <td>@p.ProgrammeName</td>
                            <td><span class="badge bg-secondary">@p.DeliveryType</span></td>
                            <td>@(p.NumberOfLearners?.ToString() ?? "—")</td>
                            <td>@(p.StartDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td>@(p.EndDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td>@p.Funding</td>
                            <td>
                                @{
                                    var statusClass = p.Status switch
                                    {
                                        "Active" => "bg-success",
                                        "Completed" => "bg-primary",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @statusClass">@p.Status</span>
                            </td>
                            <td>@(p.Coordinator?.FullName ?? "—")</td>
                            <td>@(p.Facilitator?.FullName ?? "—")</td>
                            <td>
                                <i class="bi @(p.Phase1Complete ? "bi-check-circle-fill phase-complete" : "bi-circle phase-incomplete")" title="Phase 1"></i>
                                <i class="bi @(p.Phase2Complete ? "bi-check-circle-fill phase-complete" : "bi-circle phase-incomplete") ms-1" title="Phase 2"></i>
                            </td>
                            <td>
                                <a asp-controller="Programmes" asp-action="Details" asp-route-id="@p.Id"
                                   class="btn btn-xs btn-outline-primary btn-sm py-0 px-2">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
