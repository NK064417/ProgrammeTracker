@model IEnumerable<ProgrammeTracker.Models.Programme>
@{
    ViewData["Title"] = "Programmes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count() programme(s) total</p>
    @if (User.IsInRole("Admin") || User.IsInRole("Account Manager") || User.IsInRole("Project Coordinator"))
    {
        <a asp-action="Phase1" class="btn btn-success btn-sm">
            <i class="bi bi-plus-lg"></i> New Programme
        </a>
    }
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Client</th>
                        <th>Programme</th>
                        <th>Delivery</th>
                        <th>Type</th>
                        <th>Start</th>
                        <th>Status</th>
                        <th>Phase 1</th>
                        <th>Phase 2</th>
                        <th>Deliverables</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <strong>@p.ClientName</strong>
                                @if (p.IsLegacyImport) { <span class="badge bg-secondary ms-1" style="font-size:.65rem">Legacy</span> }
                            </td>
                            <td>@p.ProgrammeName</td>
                            <td><span class="badge bg-secondary">@p.DeliveryType</span></td>
                            <td>@p.ProgrammeType?.Name</td>
                            <td>@(p.StartDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td>
                                @{
                                    var sc = p.Status switch { "Active" => "bg-success", "Completed" => "bg-primary", _ => "bg-secondary" };
                                }
                                <span class="badge @sc">@p.Status</span>
                            </td>
                            <td class="text-center">
                                @if (p.Phase1Complete)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else
                                {
                                    <a asp-action="Phase1" asp-route-id="@p.Id" class="btn btn-xs btn-outline-warning btn-sm py-0 px-1" style="font-size:.75rem">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                }
                            </td>
                            <td class="text-center">
                                @if (p.Phase2Complete)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else
                                {
                                    <a asp-action="Phase2" asp-route-id="@p.Id" class="btn btn-xs btn-outline-warning btn-sm py-0 px-1" style="font-size:.75rem">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                }
                            </td>
                            <td>
                                <a asp-controller="Deliverables" asp-action="Index" asp-route-programmeId="@p.Id" class="text-decoration-none">
                                    @p.Deliverables.Count
                                    @if (p.Deliverables.Any(d => d.IsOverdue))
                                    {
                                        <span class="badge bg-danger ms-1">!</span>
                                    }
                                </a>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary py-0 px-2">View</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">No programmes found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
