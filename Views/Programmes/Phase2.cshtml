@model ProgrammeTracker.ViewModels.ProgrammePhase2ViewModel
@{
    ViewData["Title"] = $"Phase 2 — {Model.ClientName}";
}

<div class="mb-3">
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Programme
    </a>
</div>

<!-- Progress indicator -->
<div class="card bg-light border-0 mb-4 p-3">
    <div class="d-flex gap-3 align-items-center">
        <span class="badge bg-success px-3 py-2"><i class="bi bi-check me-1"></i>Phase 1: Client Onboarding</span>
        <i class="bi bi-arrow-right text-muted"></i>
        <span class="badge bg-primary px-3 py-2">Phase 2: Implementation Plan</span>
    </div>
    <div class="mt-2 text-muted small">
        Programme: <strong>@Model.ProgrammeName</strong> &mdash; Client: <strong>@Model.ClientName</strong>
    </div>
</div>

<form asp-action="Phase2" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

    <!-- Team -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-success text-white fw-semibold">
            <i class="bi bi-people me-2"></i>Internal Team
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="CoordinatorId" class="form-label fw-semibold"></label>
                    <select asp-for="CoordinatorId" asp-items="Model.Coordinators" class="form-select">
                        <option value="">— Select —</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="FacilitatorId" class="form-label fw-semibold"></label>
                    <select asp-for="FacilitatorId" asp-items="Model.Facilitators" class="form-select">
                        <option value="">— Select —</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="TalentManagerId" class="form-label fw-semibold"></label>
                    <select asp-for="TalentManagerId" asp-items="Model.TalentManagers" class="form-select">
                        <option value="">— Select —</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="PayrollId" class="form-label fw-semibold"></label>
                    <select asp-for="PayrollId" asp-items="Model.PayrollUsers" class="form-select">
                        <option value="">— Select —</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- SETA Advisor (external) -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-success text-white fw-semibold">
            <i class="bi bi-person-badge me-2"></i>SETA Advisor (External)
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="SETAAdvisorName" class="form-label"></label>
                    <input asp-for="SETAAdvisorName" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="SETAAdvisorContact" class="form-label"></label>
                    <input asp-for="SETAAdvisorContact" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <!-- Key Dates -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-success text-white fw-semibold">
            <i class="bi bi-calendar-event me-2"></i>Key Dates
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="LearnerPresentation1Date" class="form-label fw-semibold"></label>
                    <input asp-for="LearnerPresentation1Date" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="LearnerPresentation2Date" class="form-label"></label>
                    <input asp-for="LearnerPresentation2Date" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="LearnerRegistrationDeadline" class="form-label fw-semibold"></label>
                    <input asp-for="LearnerRegistrationDeadline" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PlacementDate" class="form-label fw-semibold"></label>
                    <input asp-for="PlacementDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="SoftSkillsStartDate" class="form-label"></label>
                    <input asp-for="SoftSkillsStartDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ModerationReportDate" class="form-label"></label>
                    <input asp-for="ModerationReportDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="VerificationTriggerDate" class="form-label"></label>
                    <input asp-for="VerificationTriggerDate" type="date" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <!-- Additional -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white fw-semibold">
            <i class="bi bi-card-list me-2"></i>Additional Details
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="ReportingIntervals" class="form-label"></label>
                    <select asp-for="ReportingIntervals" asp-items="Model.ReportingIntervalOptions" class="form-select">
                        <option value="">— Select —</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="SoftSkillsYN" class="form-label"></label>
                    <select asp-for="SoftSkillsYN" class="form-select">
                        <option value="">— Select —</option>
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Mentorship" class="form-label"></label>
                    <input asp-for="Mentorship" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="AnyAddOn" class="form-label"></label>
                    <input asp-for="AnyAddOn" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="AddOnComment" class="form-label"></label>
                    <textarea asp-for="AddOnComment" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success px-4">
            <i class="bi bi-save me-1"></i>Save Phase 2
        </button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
