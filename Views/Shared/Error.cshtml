@{
    ViewData["Title"] = "Error";
}
<div class="text-center py-5">
    <i class="bi bi-exclamation-circle text-danger" style="font-size:4rem"></i>
    <h2 class="mt-3">Something went wrong</h2>
    <p class="text-muted">An unexpected error occurred. Please try again or contact your administrator.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Dashboard</a>
</div>
