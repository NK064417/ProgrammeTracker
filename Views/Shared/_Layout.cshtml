<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Programme Tracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --sidebar-width: 240px;
            --brand-color: #1a3a5c;
            --brand-accent: #2e7d32;
        }
        body { display: flex; min-height: 100vh; background: #f4f6f9; }
        #sidebar {
            width: var(--sidebar-width); min-height: 100vh; background: var(--brand-color);
            color: #fff; position: fixed; top: 0; left: 0; z-index: 100;
            display: flex; flex-direction: column;
        }
        #sidebar .brand {
            padding: 1.25rem 1rem; font-size: 1.1rem; font-weight: 700;
            border-bottom: 1px solid rgba(255,255,255,0.15); letter-spacing: .5px;
        }
        #sidebar .nav-link {
            color: rgba(255,255,255,0.75); padding: .6rem 1rem; border-radius: 6px;
            margin: 2px 8px; display: flex; align-items: center; gap: .5rem;
            font-size: .9rem; transition: all .15s;
        }
        #sidebar .nav-link:hover, #sidebar .nav-link.active {
            color: #fff; background: rgba(255,255,255,0.12);
        }
        #sidebar .nav-section {
            font-size: .7rem; text-transform: uppercase; letter-spacing: 1px;
            color: rgba(255,255,255,0.4); padding: 1rem 1rem .25rem;
        }
        #main-content { margin-left: var(--sidebar-width); flex: 1; display: flex; flex-direction: column; }
        #topbar {
            background: #fff; border-bottom: 1px solid #e0e0e0; padding: .75rem 1.5rem;
            display: flex; justify-content: space-between; align-items: center;
            position: sticky; top: 0; z-index: 50;
        }
        #topbar .page-title { font-size: 1.2rem; font-weight: 600; color: #1a3a5c; }
        .content-area { padding: 1.5rem; flex: 1; }
        .badge-overdue { background: #dc3545; }
        .badge-pending { background: #6c757d; }
        .badge-in-progress { background: #0d6efd; }
        .badge-complete { background: #198754; }
        .badge-due-soon { background: #fd7e14; }
        .phase-badge { font-size: .75rem; }
        .phase-complete { color: #198754; }
        .phase-incomplete { color: #fd7e14; }
        .legacy-badge { font-size: .7rem; background: #6c757d; }
        .stat-card { border: none; border-radius: 12px; }
        .stat-card .display-6 { font-size: 2rem; }
    </style>
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <nav id="sidebar">
        <div class="brand"><i class="bi bi-diagram-3-fill me-2"></i>Programme Tracker</div>
        <div class="px-2 pt-2 flex-grow-1">
            <div class="nav-section">Main</div>
            <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a asp-controller="Programmes" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Programmes" ? "active" : "")">
                <i class="bi bi-folder2-open"></i> Programmes
            </a>
            <a asp-controller="Deliverables" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Deliverables" ? "active" : "")">
                <i class="bi bi-check2-square"></i> Deliverables
            </a>

            @if (User.IsInRole("Admin"))
            {
                <div class="nav-section">Administration</div>
                <a asp-controller="Users" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                    <i class="bi bi-people"></i> Users
                </a>
                <a asp-controller="Notifications" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "active" : "")">
                    <i class="bi bi-bell"></i> Notifications
                </a>
                <a asp-controller="Settings" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="bi bi-gear"></i> SMTP Settings
                </a>
            }
        </div>
        <div class="p-3 border-top border-secondary">
            <small class="text-white-50 d-block mb-1">@User.Identity!.Name</small>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-sm btn-outline-light w-100">
                    <i class="bi bi-box-arrow-right"></i> Sign Out
                </button>
            </form>
        </div>
    </nav>
}

<div id="main-content">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div id="topbar">
            <span class="page-title">@ViewData["Title"]</span>
            <span class="text-muted small"><i class="bi bi-person-circle me-1"></i>@User.Identity!.Name</span>
        </div>
    }

    <div class="content-area">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
